{
  "name": "bc-rybarna-scoreboard-mobile",
  "version": "2.2.0",
  "private": true,
  "description": "BC Rybárna Scoreboard - mobilní aplikace pro iOS a Android",
  "scripts": {
    "sync": "npx cap sync",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "run:ios": "npx cap run ios",
    "run:android": "npx cap run android",
    "add:ios": "npx cap add ios",
    "add:android": "npx cap add android",
    "test": "node --test tests/*.test.cjs",
    "test:federal-cup": "node tests/federal-cup-browser.cjs",
    "test:stream": "node tests/stream-controls-browser.cjs",
    "test:stream-lag": "node tests/stream-lag-browser.cjs",
    "test:stream-isolation": "node tests/stream-isolation-browser.cjs",
    "test:pdf": "node tests/pdf-download-browser.cjs",
    "test:historical": "node tests/historical-structure-browser.cjs",
    "test:detailed": "node tests/detailed-counter-browser.cjs",
    "test:federal-evidence": "node tests/federal-evidence-browser.cjs",
    "test:federal-conflicts": "node tests/federal-evidence-conflicts-browser.cjs",
    "test:federal-calculation": "node --test tests/federal-calculation.test.cjs tests/federal-calculation-integrity.test.cjs tests/federal-tags.test.cjs",
    "test:jump-bank": "node tests/jump-bank-browser.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/android": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "playwright": "1.62.1"
  }
}
